<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <GamePath Condition="'$(GamePath)' == ''">$(PAWNPILOT_GAME_PATH)</GamePath>
    <GameManagedPath>$(GamePath)/Probably Stolen_Data/Managed</GameManagedPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PawnPilot.Contracts/PawnPilot.Contracts.csproj" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameManagedPath)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManagedPath)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManagedPath)/UnityEngine.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManagedPath)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManagedPath)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameManagedPath)/Newtonsoft.Json.dll" Private="false" />
    <None Update="manifest.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateGamePath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManagedPath)/Assembly-CSharp.dll')" Text="Game DLLs not found. Set PAWNPILOT_GAME_PATH or pass -p:GamePath=&quot;path to Probably Stolen&quot;. Game DLLs must not be copied into the repository." />
  </Target>
</Project>
